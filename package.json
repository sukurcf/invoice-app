{
  "name": "invoice-exception-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs && vite build",
    "start": "node --enable-source-maps build/server/index.js",
    "db:migrate": "tsx server/cli.ts migrate",
    "admin:create": "tsx server/cli.ts create-admin",
    "admin:reset-password": "tsx server/cli.ts reset-password",
    "db:seed": "tsx server/cli.ts seed-demo",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "check": "npm run lint && npm run build && npm run test:coverage && npm run test:integration:coverage",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
