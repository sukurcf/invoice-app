# Development only. Generate a password with: openssl rand -hex 32
# Replace the password in BOTH entries; dotenv does not expand ${VARIABLES}.
POSTGRES_PASSWORD=replace-with-generated-hex
DATABASE_URL=postgresql://invoice_dev:replace-with-generated-hex@127.0.0.1:5432/invoices
PGPORT=5432
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
SESSION_HOURS=8
LOG_LEVEL=info
