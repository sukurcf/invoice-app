{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/domain/**/*.ts", "src/services/invoiceChecks.ts", "src/utils/csv.ts", "src/data/demoData.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
